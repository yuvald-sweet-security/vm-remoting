{
  "current": "ubuntu",
  "targets": {
    "fusion-win": {
      "type": "fusion",
      "vmxPath": "/Users/you/Virtual Machines.localized/Windows.vmwarevm/Windows.vmx",
      "user": "user",
      "password": "GUEST-PASSWORD",
      "vmPassword": "VM-ENCRYPTION-PASSWORD",
      "elevated": false
    },
    "winvm": {
      "type": "hyperv",
      "vmName": "Windows 11",
      "credPath": "..." // use `vm.ps1 save-cred winvm` to generate
    },
    "ssh": {
      "type": "ssh",
      "host": "REPLACE-WITH-HOST-OR-IP",
      "user": "ubuntu",
      "key": "..."
    },
    "ubuntu": {
      "type": "wsl",
      "distro": "Ubuntu-Claude"
    }
  }
}
